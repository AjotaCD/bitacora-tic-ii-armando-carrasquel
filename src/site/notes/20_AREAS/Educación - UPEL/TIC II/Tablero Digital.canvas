<path d="M 525 530 C 525 728.0807915977721, 1010 431.9192084022279, 1010 630" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="4444444444444444"  marker-end="url(#arrow-vartextmuted)" /><text x="767.5" y="580" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">Reflexiona</text>
<path d="M 525 530 C 525 695.4690303349844, 580 774.5309696650156, 580 940" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="5ae5ce79dda4d6ff"  marker-end="url(#arrow-vartextmuted)" /><text x="552.5" y="735" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">Investiga con</text>
