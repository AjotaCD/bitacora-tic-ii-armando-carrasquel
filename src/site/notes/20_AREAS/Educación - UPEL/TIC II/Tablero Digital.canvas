		</marker><filter x="-0.1" y="-0.1" width="1.2" height="1.3" id="edge-label-bg">
			<feFlood flood-color="var(--background-primary)" flood-opacity="1" result="bg"/>
			<feMerge>
				<feMergeNode in="bg"/>
				<feMergeNode in="SourceGraphic"/>
			</feMerge>
		</filter></defs><path d="M 325 430 C 36.632179326472 430, 738.3678206735281 -280, 450 -280" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="1111111111111111"  marker-end="url(#arrow-vartextmuted)" /><text x="387.5" y="75" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">Explora</text>
<path d="M 725 430 C 925.0099997500125 430, 849.9900002499875 50, 1050 50" fill="none" stroke="var(--text-muted)" stroke-width="2" class="canvas-edge" data-edge-id="2222222222222222"  marker-end="url(#arrow-vartextmuted)" /><text x="887.5" y="240" class="canvas-edge-label" filter="url(#edge-label-bg)" fill="var(--text-muted)">Previene</text>
